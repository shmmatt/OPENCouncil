    "verify:s3": "tsx --env-file=.env scripts/verify-s3-state.ts",
    "test:sitemap": "tsx --env-file=.env scripts/sitemap-parser-improved.ts",
    "backfill:s3": "tsx --env-file=.env scripts/backfill-s3-to-db.ts",
    "ingest:discover": "tsx --env-file=.env scripts/run-ingestion.ts discover",
    "ingest:worker": "tsx --env-file=.env scripts/run-ingestion.ts worker",
    "ingest:all": "tsx --env-file=.env scripts/run-ingestion.ts all"
