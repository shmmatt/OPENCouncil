{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index-dev.ts",
    "build": "vite build && esbuild server/index-prod.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "test:chat": "tsx --env-file=.env scripts/test-chat-pipeline.ts",
    "test:chat:all": "tsx --env-file=.env scripts/test-chat-pipeline.ts run --sets all",
    "test:chat:basic": "tsx --env-file=.env scripts/test-chat-pipeline.ts run --sets basic",
    "test:chat:permits": "tsx --env-file=.env scripts/test-chat-pipeline.ts run --sets permits",
    "test:chat:legal": "tsx --env-file=.env scripts/test-chat-pipeline.ts run --sets legal",
